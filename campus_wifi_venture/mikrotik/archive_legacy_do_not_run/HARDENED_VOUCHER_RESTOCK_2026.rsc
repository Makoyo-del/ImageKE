# --- 2. REMOVE UNUSED 12H PACKAGE ---
:do { /ip hotspot user profile remove [find name="pkg_12h"] } on-error={}

# --- 3. HARDEN HOTSPOT PROFILE (Prevent Stale Cookie Bypass) ---
:do { /ip hotspot profile set [find default=yes] http-cookie-lifetime=1d } on-error={}

# --- 4. FLUSH EXPIRED SESSIONS & COOKIES ---
/ip hotspot active remove [find]
/ip hotspot cookie remove [find]

